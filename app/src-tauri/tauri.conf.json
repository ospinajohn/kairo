{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kairo-poc",
  "version": "0.1.0",
  "identifier": "com.nodex.kairo-poc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kairo POC",
        "width": 352,
        "height": 352,
        "minWidth": 352,
        "minHeight": 352,
        "maxWidth": 352,
        "maxHeight": 352,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
